<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- Spec. 3.4: Workstation GC bez concurrent rezima i ReadyToRun (varijanta C, odobreno 16.11.2026.). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LustreRadio.Core\LustreRadio.Core.csproj" />
    <ProjectReference Include="..\LustreRadio.Ipc\LustreRadio.Ipc.csproj" />
    <ProjectReference Include="..\LustreRadio.Presentation\LustreRadio.Presentation.csproj" />
    <ProjectReference Include="..\LustreRadio.Voice\LustreRadio.Voice.csproj" />
    <ProjectReference Include="..\LustreRadio.Data\LustreRadio.Data.csproj" />
    <ProjectReference Include="..\LustreRadio.Audio\LustreRadio.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <Compile Include="..\Shared\LogSetup.cs" Link="Shared\LogSetup.cs" />
  </ItemGroup>
</Project>
